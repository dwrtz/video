{
  "name": "video",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fix-webm-duration": "^1.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
  }
}
